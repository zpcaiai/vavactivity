{
  "name": "vav-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.0.0 <27"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "postbuild": "node scripts/vercel-merge.mjs",
    "dev": "pnpm --parallel --filter @vav/user-web --filter @vav/admin-web dev",
    "lint": "pnpm --recursive --if-present lint",
    "test": "pnpm --recursive --if-present test",
    "test:e2e": "playwright test",
    "test:e2e:batch16": "playwright test e2e/user-relationships e2e/admin-relationships",
    "test:e2e:batch17": "playwright test e2e/user-memberships e2e/admin-memberships",
    "test:e2e:batch16-17": "playwright test e2e/user-relationships e2e/admin-relationships e2e/user-memberships e2e/admin-memberships",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "generate:api": "pnpm --filter @vav/api-client generate"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@vav/ui-testing": "workspace:*"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "4.3.1"
    }
  }
}
