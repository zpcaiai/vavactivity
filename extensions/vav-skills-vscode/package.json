{
  "name": "@vav/skills-vscode",
  "displayName": "VAV Skills",
  "description": "Fail-closed Skill manifest validation and local developer commands",
  "version": "1.0.0",
  "private": true,
  "engines": {"vscode": ">=1.100.0"},
  "categories": ["Linters", "Testing", "Other"],
  "activationEvents": ["workspaceContains:**/skill.yaml", "onCommand:vavSkills.validate"],
  "main": "./src/extension.js",
  "extensionDependencies": ["redhat.vscode-yaml"],
  "scripts": {
    "build": "node --check src/extension.js",
    "lint": "node --check src/extension.js",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "node --check src/extension.js"
  },
  "contributes": {
    "commands": [
      {"command": "vavSkills.create", "title": "VAV Skills: Create Skill"},
      {"command": "vavSkills.validate", "title": "VAV Skills: Validate Manifest and Schemas"},
      {"command": "vavSkills.test", "title": "VAV Skills: Run Contract Tests"},
      {"command": "vavSkills.build", "title": "VAV Skills: Build Deterministic Package"},
      {"command": "vavSkills.schemaDiff", "title": "VAV Skills: Compare Schemas"},
      {"command": "vavSkills.doctor", "title": "VAV Skills: Diagnose Package"}
    ],
    "yamlValidation": [
      {
        "fileMatch": ["**/skill.yaml"],
        "url": "./schemas/skill-manifest.schema.json"
      }
    ],
    "configuration": {
      "title": "VAV Skills",
      "properties": {
        "vavSkills.cliPath": {
          "type": "string",
          "default": "./scripts/vavctl",
          "description": "Workspace-relative VAV control command. Credentials are never accepted here."
        }
      }
    }
  }
}
