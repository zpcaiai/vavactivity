{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skills://vav.example.echo/1.0.0/error",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "message_safe"],
  "properties": {
    "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,127}$"},
    "message_safe": {"type": "string", "minLength": 1, "maxLength": 1000}
  }
}
