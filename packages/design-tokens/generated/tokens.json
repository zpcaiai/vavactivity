{
  "version": "1.0.0",
  "primitive": {
    "color": {
      "neutral000": "#ffffff",
      "neutral050": "#fffdf9",
      "neutral100": "#f4f1ea",
      "neutral300": "#ded8ce",
      "neutral600": "#66736f",
      "neutral900": "#24322f",
      "rose500": "#8c4f5e",
      "rose700": "#713b49",
      "gold500": "#c9985b",
      "green600": "#3d7869",
      "red600": "#a84545",
      "amber700": "#8a5b17",
      "blue700": "#24535b"
    },
    "space": {
      "0": "0",
      "1": "0.25rem",
      "2": "0.5rem",
      "3": "0.75rem",
      "4": "1rem",
      "6": "1.5rem",
      "8": "2rem",
      "12": "3rem",
      "16": "4rem"
    },
    "radius": {
      "sm": "0.5rem",
      "md": "1rem",
      "lg": "1.5rem",
      "pill": "999px"
    },
    "font": {
      "sans": "Inter, Noto Sans SC, PingFang SC, system-ui, sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, monospace"
    },
    "fontSize": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "1rem",
      "lg": "1.25rem",
      "xl": "1.75rem",
      "2xl": "2.5rem"
    },
    "lineHeight": {
      "tight": "1.25",
      "normal": "1.5",
      "relaxed": "1.7"
    },
    "shadow": {
      "soft": "0 18px 55px rgb(73 55 48 / 10%)",
      "focus": "0 0 0 3px rgb(36 83 91 / 35%)"
    }
  },
  "semantic": {
    "light": {
      "color": {
        "text": "{color.neutral900}",
        "textMuted": "{color.neutral600}",
        "ink": "{color.neutral900}",
        "muted": "{color.neutral600}",
        "surface": "{color.neutral050}",
        "surfaceRaised": "{color.neutral000}",
        "surfaceSoft": "{color.neutral100}",
        "border": "{color.neutral300}",
        "actionPrimary": "{color.rose500}",
        "actionPrimaryHover": "{color.rose700}",
        "onAction": "{color.neutral000}",
        "overlay": "rgb(0 0 0 / 55%)",
        "primary": "{color.rose500}",
        "primaryStrong": "{color.rose700}",
        "focus": "{color.blue700}",
        "success": "{color.green600}",
        "warning": "{color.amber700}",
        "danger": "{color.red600}",
        "accent": "{color.gold500}"
      }
    },
    "dark": {
      "color": {
        "text": "#f5f7f8",
        "textMuted": "#b7c2c7",
        "ink": "#f5f7f8",
        "muted": "#b7c2c7",
        "surface": "#091722",
        "surfaceRaised": "#132632",
        "surfaceSoft": "#1c3340",
        "border": "#50626b",
        "actionPrimary": "#e5818d",
        "actionPrimaryHover": "#f29ba5",
        "onAction": "#091722",
        "overlay": "rgb(0 0 0 / 72%)",
        "primary": "#e5818d",
        "primaryStrong": "#f29ba5",
        "focus": "#8ed5e0",
        "success": "#77b7a7",
        "warning": "#e8b565",
        "danger": "#ff9aa3",
        "accent": "#efae93"
      }
    },
    "high-contrast": {
      "color": {
        "text": "#000000",
        "textMuted": "#1f1f1f",
        "ink": "#000000",
        "muted": "#1f1f1f",
        "surface": "#ffffff",
        "surfaceRaised": "#ffffff",
        "surfaceSoft": "#f0f0f0",
        "border": "#000000",
        "actionPrimary": "#003b80",
        "actionPrimaryHover": "#001f4d",
        "onAction": "#ffffff",
        "overlay": "rgb(0 0 0 / 85%)",
        "primary": "#003b80",
        "primaryStrong": "#001f4d",
        "focus": "#ffbf00",
        "success": "#005a24",
        "warning": "#6b3b00",
        "danger": "#8f0000",
        "accent": "#4b2e00"
      }
    }
  },
  "component": {
    "button": {
      "height": "2.75rem",
      "paddingInline": "{space.4}",
      "radius": "{radius.sm}"
    },
    "input": {
      "height": "2.75rem",
      "paddingInline": "{space.3}",
      "radius": "{radius.sm}"
    },
    "dialog": {
      "maxWidth": "40rem",
      "radius": "{radius.lg}"
    },
    "card": {
      "padding": "{space.6}",
      "radius": "{radius.md}"
    },
    "touchTarget": {
      "minimum": "2.75rem"
    }
  },
  "layout": {
    "breakpoint": {
      "mobile": "22.5rem",
      "tablet": "48rem",
      "desktop": "64rem",
      "wide": "90rem"
    },
    "content": {
      "reading": "46rem",
      "standard": "75rem",
      "wide": "90rem"
    },
    "grid": {
      "gutter": "1rem",
      "columnsMobile": "4",
      "columnsTablet": "8",
      "columnsDesktop": "12"
    },
    "safeArea": {
      "bottom": "env(safe-area-inset-bottom, 0px)",
      "top": "env(safe-area-inset-top, 0px)"
    }
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast": "120ms",
      "normal": "200ms",
      "slow": "320ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "exit": "cubic-bezier(0.4, 0, 1, 1)"
    }
  },
  "density": {
    "comfortable": {
      "controlHeight": "2.75rem",
      "rowHeight": "3.25rem",
      "pageGap": "1.5rem"
    },
    "compact": {
      "controlHeight": "2.25rem",
      "rowHeight": "2.5rem",
      "pageGap": "1rem"
    }
  }
}
