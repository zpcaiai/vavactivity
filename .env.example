# Development-only values. Never reuse these credentials outside a local machine.
APP_ENV=development
APP_VERSION=0.1.0
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
APP_DISPLAY_TIMEZONE=Asia/Shanghai

POSTGRES_DB=vav
POSTGRES_USER=vav
POSTGRES_PASSWORD=vav_local_development_only
DATABASE_URL=postgresql+asyncpg://vav:vav_local_development_only@postgres:5432/vav

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

MINIO_ROOT_USER=vav_minio_local
MINIO_ROOT_PASSWORD=vav_minio_local_development_only
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=vav-private
MINIO_SECURE=false

VITE_API_BASE_URL=http://localhost:8000/api/v1

