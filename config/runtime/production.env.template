# Non-secret production settings only. Inject secret values from the deployment secret manager.
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["https://www.vav.example","https://admin.vav.example"]
AUTH_PRIVATE_KEY_FILE=/run/secrets/auth-private-key
AUTH_PUBLIC_KEY_FILE=/run/secrets/auth-public-key
AUTH_COOKIE_SECURE=true
PAYMENT_ENVIRONMENT=live
PAYMENT_TEST_FAKE_ENABLED=false
COURSE_VIDEO_PROVIDER=approved_private
COUNSELING_MEETING_PROVIDER=approved
KNOWLEDGE_EMBEDDING_PROVIDER=approved
AI_MODEL_PROVIDER=approved
AI_CONVERSATION_ENCRYPTION_ENABLED=true
NOTIFICATION_EMAIL_PROVIDER=transactional
PRIVACY_FIELD_ENCRYPTION_ENABLED=true
PRIVACY_EXPORT_ENCRYPTION_ENABLED=true
MEDIA_S3_ENDPOINT=https://object-storage.internal
MEDIA_S3_PUBLIC_ENDPOINT=https://media.vav.example

# Secret values are intentionally absent. The production Compose/Kubernetes
# deployment contracts require the orchestrator or secret manager to inject
# them and fail before container creation when any required value is missing.
