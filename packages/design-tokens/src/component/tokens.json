{
  "button": {"height": "2.75rem", "paddingInline": "{space.4}", "radius": "{radius.sm}"},
  "input": {"height": "2.75rem", "paddingInline": "{space.3}", "radius": "{radius.sm}"},
  "dialog": {"maxWidth": "40rem", "radius": "{radius.lg}"},
  "card": {"padding": "{space.6}", "radius": "{radius.md}", "paddingCompact": "{space.4}", "gap": "{space.4}"},
  "touchTarget": {"minimum": "2.75rem"},
  "navItem": {"height": "2.5rem", "radius": "{radius.sm}", "paddingInline": "{space.3}", "gap": "{space.3}"},
  "chip": {"height": "1.75rem", "paddingInline": "{space.3}", "radius": "{radius.pill}"},
  "avatar": {"size": "2.5rem", "sizeLarge": "4rem", "radius": "{radius.pill}"},
  "metric": {"padding": "{space.5}", "radius": "{radius.md}"},
