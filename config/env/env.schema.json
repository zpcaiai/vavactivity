{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vav.example/schemas/deployment-environment-1.0.0.json",
  "title": "VAV deployment environment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment", "application", "providers", "data", "observability", "secrets", "feature_flags"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "environment": {"enum": ["development", "test", "ci", "staging", "production", "dr"]},
    "application": {"type": "object"},
    "providers": {"type": "object"},
    "data": {"type": "object"},
    "observability": {"type": "object"},
    "secrets": {"type": "object", "description": "References only; secret values are forbidden."},
    "feature_flags": {"type": "object"}
  }
}
