# Development-only values. Never reuse these credentials outside a local machine.
APP_ENV=development
APP_VERSION=0.1.0
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]
APP_DISPLAY_TIMEZONE=Asia/Shanghai

POSTGRES_DB=vav
POSTGRES_USER=vav
POSTGRES_PASSWORD=vav_local_development_only
DATABASE_URL=postgresql+asyncpg://vav:vav_local_development_only@postgres:5432/vav

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

MINIO_ROOT_USER=vav_minio_local
MINIO_ROOT_PASSWORD=vav_minio_local_development_only
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=vav-private
MINIO_SECURE=false

VITE_API_BASE_URL=http://localhost:8000/api/v1

# Batch 2 identity. Development-only values; generate local Ed25519 keys with
# ./scripts/generate-dev-auth-keys.sh.
AUTH_ISSUER=vav-platform
AUTH_USER_AUDIENCE=vav-user
AUTH_ADMIN_AUDIENCE=vav-admin
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_CLOCK_SKEW_SECONDS=30
AUTH_PRIVATE_KEY_FILE=/run/secrets/auth-private.pem
AUTH_PUBLIC_KEY_FILE=/run/secrets/auth-public.pem
AUTH_ACTIVE_KEY_ID=dev-key-1
AUTH_REFRESH_TOKEN_PEPPER=local-refresh-pepper-change-me
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_ADMIN_REFRESH_TOKEN_TTL_HOURS=12
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_PASSWORD_MAX_LENGTH=128
AUTH_ARGON2_TIME_COST=3
AUTH_ARGON2_MEMORY_COST=65536
AUTH_ARGON2_PARALLELISM=4
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_EMAIL_VERIFICATION_TTL_HOURS=24
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_EMAIL_RESEND_COOLDOWN_SECONDS=60
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174"]
USER_WEB_URL=http://localhost:5173
ADMIN_WEB_URL=http://localhost:5174
PUBLIC_WEB_BASE_URL=http://localhost:5173
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_SITE_INDEXING_ENABLED=false
SMTP_HOST=mailpit
SMTP_PORT=1025
EMAIL_FROM=no-reply@vav.local

# Batch 3 content and media.
CMS_DEFAULT_LOCALE=zh-CN
CMS_SUPPORTED_LOCALES=["zh-CN","zh-TW","en"]
CMS_FALLBACK_LOCALE=zh-CN
CMS_ALLOW_LOCALE_FALLBACK=true
CMS_REQUIRE_REVIEW_FOR_PUBLISH=true
CMS_PREVIEW_TOKEN_TTL_MINUTES=30
CMS_PUBLIC_CACHE_TTL_SECONDS=300
MEDIA_STORAGE_PROVIDER=s3
MEDIA_S3_ENDPOINT=http://minio:9000
MEDIA_S3_PUBLIC_ENDPOINT=http://localhost:9000
MEDIA_S3_REGION=us-east-1
MEDIA_S3_ACCESS_KEY=vav_minio_local
MEDIA_S3_SECRET_KEY=vav_minio_local_development_only
MEDIA_S3_BUCKET_PUBLIC=vav-public
MEDIA_S3_BUCKET_PRIVATE=vav-private
MEDIA_MAX_IMAGE_SIZE_MB=10
MEDIA_MAX_DOCUMENT_SIZE_MB=25
MEDIA_PRESIGNED_UPLOAD_TTL_SECONDS=900
PUBLIC_SITE_NAME=VAV
PUBLIC_SITE_BASE_URL=http://localhost:5173
CONTACT_FORM_MAX_MESSAGE_LENGTH=5000
CONTACT_CONFIRMATION_EMAIL_ENABLED=false

# Batch 4 catalog. Prices are explicit integer minor units; exchange rates are
# reference-only.
CATALOG_DEFAULT_CURRENCY=USD
CATALOG_SUPPORTED_CURRENCIES=["CNY","USD","TWD","HKD"]
CATALOG_REQUIRE_REVIEW_FOR_PUBLISH=true
CATALOG_PUBLIC_CACHE_TTL_SECONDS=300
PRICING_QUOTE_TTL_MINUTES=15
PRICING_ALLOW_LOCALE_FALLBACK=true
PRICING_FAIL_ON_CONFIGURATION_CONFLICT=true
PRICING_DISCOUNT_ROUNDING_MODE=half_up
PRICING_MAX_QUANTITY_PER_QUOTE=100
INVENTORY_RESERVATION_TTL_MINUTES=15
INVENTORY_LOW_STOCK_THRESHOLD=5
INVENTORY_ALLOW_NEGATIVE=false
INVENTORY_EXPIRATION_JOB_INTERVAL_SECONDS=60
PROMOTION_MAX_STACKED_COUNT=3
PROMOTION_COUPON_ATTEMPT_LIMIT=10/hour
PROMOTION_DEFAULT_STACKABILITY=exclusive
EXCHANGE_RATE_PROVIDER=manual
EXCHANGE_RATE_REFERENCE_ONLY=true

# Batch 5 commerce. The local fake is restricted to development/test and every
# success still requires a signed Webhook.
COMMERCE_ORDER_EXPIRATION_MINUTES=30
COMMERCE_CART_EXPIRATION_DAYS=30
COMMERCE_CHECKOUT_IDEMPOTENCY_TTL_HOURS=24
COMMERCE_REQUIRE_BILLING_EMAIL=true
PAYMENT_ENABLED_PROVIDERS=["stripe","paypal"]
PAYMENT_DEFAULT_PROVIDER=stripe
PAYMENT_ENVIRONMENT=test
PAYMENT_TEST_FAKE_ENABLED=true
PAYMENT_TEST_WEBHOOK_SECRET=local-commerce-webhook-change-me
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
STRIPE_SUCCESS_URL=http://localhost:5173/zh-CN/checkout/processing
STRIPE_CANCEL_URL=http://localhost:5173/zh-CN/checkout/cancelled
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_RETURN_URL=http://localhost:5173/zh-CN/checkout/processing
PAYPAL_CANCEL_URL=http://localhost:5173/zh-CN/checkout/cancelled
SUBSCRIPTION_GRACE_PERIOD_DAYS=3
SUBSCRIPTION_CANCEL_AT_PERIOD_END_DEFAULT=true
SUBSCRIPTION_IMMEDIATE_CANCELLATION_ENABLED=false
REFUND_APPROVAL_REQUIRED=true
REFUND_AUTO_APPROVAL_MAX_MINOR=0
ENTITLEMENT_ACTIVATION_MAX_ATTEMPTS=10
ENTITLEMENT_ACTIVATION_RETRY_SECONDS=60
RECONCILIATION_LOOKBACK_DAYS=7
RECONCILIATION_JOB_INTERVAL_MINUTES=30

# Activities (protective defaults; business policies remain undecided)
ACTIVITY_REQUIRE_REVIEW_FOR_PUBLISH=true
ACTIVITY_DEFAULT_TIMEZONE=Asia/Taipei
ACTIVITY_PUBLIC_CACHE_TTL_SECONDS=300
ACTIVITY_ALLOW_GUEST_REGISTRATION=false
ACTIVITY_REGISTRATION_MAX_ACTIVE_PER_USER=1
ACTIVITY_REGISTRATION_FORM_MAX_FIELDS=30
ACTIVITY_REGISTRATION_PAYMENT_INVITATION_TTL_MINUTES=30
ACTIVITY_WAITLIST_PROMOTION_TTL_MINUTES=30
ACTIVITY_WAITLIST_AUTO_PROMOTION_ENABLED=true
ACTIVITY_WAITLIST_JOB_INTERVAL_SECONDS=60
ACTIVITY_CHECKIN_QR_TTL_SECONDS=60
ACTIVITY_CHECKIN_ALLOW_EARLY_MINUTES=60
ACTIVITY_CHECKIN_ALLOW_LATE_MINUTES=120
ACTIVITY_GROUPING_MAX_GROUP_SIZE=20
ACTIVITY_GROUPING_REQUIRE_CHECKIN=false
ACTIVITY_POST_EVENT_MAX_INTERESTED_CHOICES=5
ACTIVITY_POST_EVENT_REQUIRE_CHECKIN=true
ACTIVITY_POST_EVENT_CONTACT_EXCHANGE_MODE=mutual_confirmation_required
ACTIVITY_POST_EVENT_DEFAULT_WINDOW_HOURS=72

# Courses (provider-neutral and privacy-preserving defaults)
COURSE_REQUIRE_REVIEW_FOR_PUBLISH=true
COURSE_DEFAULT_LOCALE=zh-CN
COURSE_PUBLIC_CACHE_TTL_SECONDS=300
COURSE_DEFAULT_VERSION_POLICY=pin_at_enrollment
COURSE_ALLOW_FREE_ENROLLMENT=true
COURSE_RELEASE_JOB_INTERVAL_SECONDS=60
COURSE_DEFAULT_RELEASE_POLICY=all_at_once
COURSE_VIDEO_PROVIDER=fake_private
COURSE_VIDEO_PLAYBACK_URL_TTL_SECONDS=300
COURSE_VIDEO_SESSION_TTL_MINUTES=120
COURSE_VIDEO_HEARTBEAT_INTERVAL_SECONDS=20
COURSE_VIDEO_HEARTBEAT_TOLERANCE_SECONDS=10
COURSE_VIDEO_MAX_CONCURRENT_SESSIONS=3
COURSE_VIDEO_DOWNLOAD_ENABLED=false
COURSE_VIDEO_DEFAULT_REQUIRED_WATCH_BPS=9000
COURSE_PROGRESS_EVENT_MAX_BATCH_SIZE=50
COURSE_PROGRESS_ALLOW_MANUAL_COMPLETION=true
COURSE_PROGRESS_CONFLICT_POLICY=monotonic_completion
COURSE_EXERCISE_AUTOSAVE_SECONDS=30
COURSE_EXERCISE_MAX_QUESTIONS=200
COURSE_ASSIGNMENT_MAX_FILE_SIZE_MB=25
COURSE_ASSIGNMENT_ALLOWED_TYPES=application/pdf,image/jpeg,image/png
COURSE_COMPLETION_JOB_INTERVAL_SECONDS=60
COURSE_CERTIFICATE_ENABLED=true
COURSE_CERTIFICATE_PUBLIC_NAME_MODE=masked
COURSE_CERTIFICATE_VERIFICATION_TOKEN_TTL_DAYS=0

# Counseling (recording and transcription remain disabled by default)
COUNSELING_DEFAULT_BOOKING_MODE=request_and_confirm
COUNSELING_DEFAULT_APPROVAL_POLICY=manual
COUNSELING_DEFAULT_PAYMENT_TIMING=after_time_approval
COUNSELING_DEFAULT_TIMEZONE=Asia/Taipei
COUNSELING_SLOT_INTERVAL_MINUTES=15
COUNSELING_SLOT_HOLD_TTL_MINUTES=15
COUNSELING_DEFAULT_MINIMUM_NOTICE_MINUTES=1440
COUNSELING_DEFAULT_MAXIMUM_ADVANCE_DAYS=60
COUNSELING_AVAILABILITY_CACHE_TTL_SECONDS=60
COUNSELING_AVAILABILITY_MAX_RANGE_DAYS=90
COUNSELING_PAYMENT_INVITATION_TTL_MINUTES=30
COUNSELING_MAX_ACTIVE_APPOINTMENTS_PER_USER=5
COUNSELING_RESCHEDULE_MAX_COUNT=3
COUNSELING_CHECKIN_OPEN_MINUTES_BEFORE=15
COUNSELING_JOIN_OPEN_MINUTES_BEFORE=10
COUNSELING_JOIN_CLOSE_MINUTES_AFTER=30
COUNSELING_MEETING_PROVIDER=fake
COUNSELING_MEETING_JOIN_URL_TTL_SECONDS=300
COUNSELING_RECORDING_ENABLED=false
COUNSELING_TRANSCRIPTION_ENABLED=false
COUNSELING_CREDIT_RESERVATION_TTL_HOURS=24
COUNSELING_DEFAULT_NO_SHOW_CREDIT_POLICY=manual_review
COUNSELING_CLIENT_SUMMARY_RETENTION_DAYS=0
COUNSELING_MENTOR_NOTE_RETENTION_DAYS=0
COUNSELING_SAFETY_RECORD_RETENTION_DAYS=0
COUNSELING_SAFETY_ESCALATION_ENABLED=true
COUNSELING_IMMEDIATE_RISK_AUTO_PAUSE_GENERAL_ADVICE=true

# Knowledge and retrieval
KNOWLEDGE_DEFAULT_LOCALE=zh-CN
KNOWLEDGE_SUPPORTED_LOCALES=zh-CN,zh-TW,en
KNOWLEDGE_REQUIRE_AUTHORIZATION=true
KNOWLEDGE_REQUIRE_REVIEW_BEFORE_PUBLISH=true
KNOWLEDGE_MAX_UPLOAD_SIZE_MB=100
KNOWLEDGE_PARSER_TIMEOUT_SECONDS=120
KNOWLEDGE_MIN_PARSE_QUALITY_BPS=8000
KNOWLEDGE_BLOCK_LOW_QUALITY_AUTOPUBLISH=true
KNOWLEDGE_CHUNK_STRATEGY=heading_aware_v1
KNOWLEDGE_CHUNK_TARGET_TOKENS=500
KNOWLEDGE_CHUNK_MAX_TOKENS=800
KNOWLEDGE_CHUNK_MIN_TOKENS=100
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=80
KNOWLEDGE_PARENT_CHUNK_MAX_TOKENS=1600
KNOWLEDGE_EMBEDDING_PROVIDER=fake
KNOWLEDGE_EMBEDDING_PROFILE=default-multilingual
KNOWLEDGE_EMBEDDING_BATCH_TOKEN_LIMIT=20000
KNOWLEDGE_EMBEDDING_MAX_RETRIES=5
